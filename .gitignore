# ROS / colcon build and runtime output (also applies to nested workspaces).
build/
install/
log/

# Locally built third-party runtimes; keep their build/run scripts in Git.
/.cuda_realsense/
/.isaac_ros_compare/
/.ros_image_proc/

# Per-machine Docker state, Xauthority cookies, writable settings and tool caches.
/.docker-local/

# Recorded datasets, generated figures, paper analyses and benchmark binaries.
/record/
/analysis/
/docs/analysis/
/docs/images/
figures/

# Local model bundles are supplied separately from the inference source.
/src/estimation_pkg/models/

# Python / test / tooling caches and generated packaging metadata.
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
*.egg-info/
.pio/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof
*.pstats

# Local editor state and temporary files.
.vscode/
*.swp
*.swo
*~
.DS_Store

# Paper-only working files; these are not used by the robot runtime.
/docs/FORCE_ESTIMATION_BASELINE_COMPARISON_KO.md
/docs/IDEstimationAnalysis.m

