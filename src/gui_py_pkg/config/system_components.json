{
  "components": [
    {
      "id": "camera",
      "label": "HRM camera (CUDA)",
      "package": "launcher",
      "launch_file": "cuda_realsense.launch.py",
      "expected_nodes": ["/camera/camera"],
      "auto_start": true,
      "delay_sec": 0.0,
      "description": "CUDA color and aligned depth; select model and optional serial before Start",
      "arguments": {
        "device_type": "{camera_device_type}",
        "serial_no": "{camera_serial_no}"
      }
    },
    {
      "id": "tag_camera",
      "label": "Tag camera (CUDA)",
      "package": "launcher",
      "launch_file": "cuda_apriltag_camera.launch.py",
      "expected_nodes": ["/tag_camera/tag_camera"],
      "auto_start": true,
      "delay_sec": 0.5,
      "description": "Separate RGB camera for AprilTag; default D455",
      "arguments": {
        "device_type": "{tag_camera_device_type}",
        "serial_no": "{tag_camera_serial_no}"
      }
    },
    {
      "id": "serial",
      "label": "Serial sensors",
      "package": "serial_pkg",
      "launch_file": "_launch.py",
      "expected_nodes": ["/serial_read"],
      "auto_start": true,
      "delay_sec": 1.0,
      "description": "Load cells and force/torque sensor",
      "arguments": {
        "serial_port": "{serial_port}"
      }
    },
    {
      "id": "tcp",
      "label": "Motor TCP bridge",
      "package": "tcp_pkg",
      "launch_file": "_launch.py",
      "expected_nodes": ["/tcpclient"],
      "auto_start": true,
      "delay_sec": 2.0,
      "description": "Linux ROS 2 to the Windows motor server"
    },
    {
      "id": "robot_control",
      "label": "Robot control",
      "package": "robot_control_pkg",
      "launch_file": "_launch.py",
      "expected_nodes": ["/robot_control"],
      "auto_start": true,
      "delay_sec": 3.0,
      "description": "IK, FK and motor command generation",
      "arguments": {
        "motor_output_enabled": "{motor_output_enabled}"
      }
    },
    {
      "id": "estimation",
      "label": "Segment estimation",
      "package": "estimation_pkg",
      "launch_file": "_launch.py",
      "expected_nodes": ["/segment_angle_estimator"],
      "auto_start": true,
      "delay_sec": 4.0,
      "description": "Skeleton, 3D reconstruction and joint angles",
      "arguments": {
        "roi_x": "{roi_x}",
        "roi_y": "{roi_y}",
        "roi_width": "{roi_width}",
        "roi_height": "{roi_height}"
      }
    },
    {
      "id": "record",
      "label": "Data recorder",
      "package": "record_pkg",
      "launch_file": "_launch.py",
      "expected_nodes": ["/record"],
      "auto_start": false,
      "delay_sec": 5.0,
      "description": "HRM crop PNGs plus numeric sensor/motor/angle/tag bag; automatic CSV after Record Stop"
    },
    {
      "id": "apriltag",
      "label": "AprilTag",
      "package": "launcher",
      "launch_file": "apriltag.launch.py",
      "expected_nodes": ["/apriltag_node", "/apriltag_pose", "/apriltag_preprocess/rectify_color"],
      "auto_start": true,
      "delay_sec": 6.0,
      "description": "Tag camera RGB rectification and 20 mm ID0/ID1 poses"
    }
  ]
}
