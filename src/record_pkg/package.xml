<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>record_pkg</name>
  <version>0.0.0</version>
  <description>Timestamp-preserving HRM sensor and control rosbag recorder</description>
  <maintainer email="bigyun9375@gmail.com">daeyun</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>custom_interfaces</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
